{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ODEN committed memory batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease",
    "goal_rev",
    "results"
  ],
  "properties": {
    "lease": {
      "type": "string",
      "minLength": 1
    },
    "goal_rev": {
      "type": "integer",
      "minimum": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "summary",
          "room",
          "coverage"
        ],
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 800
          },
          "room": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "coverage": {
            "enum": [
              "read",
              "partial"
            ]
          },
          "keywords": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "unresolved": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          },
          "visual_check": {
            "type": "object",
            "required": [
              "status",
              "method",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "inspected",
                  "not_needed",
                  "deferred"
                ]
              },
              "method": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          },
          "claims": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "kind"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 1000
                },
                "kind": {
                  "enum": [
                    "fact",
                    "inference",
                    "unknown",
                    "visual_observation"
                  ]
                },
                "quote": {
                  "type": "string",
                  "maxLength": 1500
                },
                "qualifiers": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "maxLength": 500
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
