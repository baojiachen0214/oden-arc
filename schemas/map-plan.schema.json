{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oden:mapplan:1",
  "title": "ODEN MapPlan 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_version",
    "document_id",
    "title",
    "goal",
    "nodes"
  ],
  "properties": {
    "plan_version": {
      "const": "1.0"
    },
    "document_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "object",
      "required": [
        "purpose",
        "question"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "learn",
            "decide",
            "act",
            "reference",
            "explain"
          ]
        },
        "question": {
          "type": "string"
        },
        "must_answer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "cross_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "audit": {
      "type": "object"
    },
    "settings": {
      "type": "object",
      "properties": {
        "layout": {
          "enum": [
            "right",
            "left"
          ]
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "status",
        "coverage"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "enum": [
            "read",
            "partial",
            "unread",
            "unavailable"
          ]
        },
        "coverage": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "asset": {
      "type": "object",
      "required": [
        "id",
        "path",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "image",
            "pdf",
            "text",
            "audio",
            "video",
            "file"
          ]
        },
        "name": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "parent_id",
        "label",
        "role",
        "support"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "role": {
          "type": "string"
        },
        "support": {
          "enum": [
            "fact",
            "inference",
            "uncertain",
            "user",
            "structure"
          ]
        },
        "body": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "paragraph",
                  "heading",
                  "list",
                  "task",
                  "code",
                  "equation"
                ]
              }
            }
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "locator"
            ],
            "properties": {
              "source_id": {
                "type": "string"
              },
              "locator": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
