    {
      "id": "equation",
      "parent_id": "root",
      "label": "Blend the new observation with the previous value",
      "role": "mechanism",
      "support": "fact",
      "source_refs": [
        {
          "source_id": "lesson",
          "locator": "Definition"
        }
      ],
      "body": [
        {
          "kind": "equation",
          "latex": "y_t=\\alpha x_t+(1-\\alpha)y_{t-1}"
        }
      ],
      "note": "x_t: new observation; y_(t-1): previous smoothed value; alpha: dimensionless weight."
    },
    {
      "id": "assumptions",
      "parent_id": "root",
      "label": "Use the same units, an initial value and alpha in [0,1]",
      "role": "constraint",
      "support": "fact",
