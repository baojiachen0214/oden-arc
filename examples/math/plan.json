          "source_id": "s-lesson",
          "locator": "更新规则"
        }
      ],
      "body": [
        {
          "kind": "equation",
          "latex": "\\ell_t = \\alpha y_t + (1-\\alpha)\\ell_{t-1}"
        }
      ],
      "note": "y_t：本期观测；l_t：本期水平；alpha：本期观测权重。公式按讲义保留。"
    },
    {
      "id": "range",
      "parent_id": "update",
      "label": "参数范围与初值必须一同保留",
      "role": "caveat",
      "support": "fact",
      "source_refs": [
        {
          "source_id": "s-lesson",
          "locator": "更新规则"
        }
      ],
      "body": [
        {
          "kind": "equation",
          "latex": "0 < \\alpha < 1,\\quad \\ell_1=y_1"
        }
      ]
    },
    {
      "id": "calculate",
      "parent_id": "update",
      "label": "算一次：100 更新为 106",
      "role": "step",
      "support": "fact",
      "source_refs": [
        {
          "source_id": "s-lesson",
          "locator": "算一次"
        }
      ],
      "body": [
        {
          "kind": "equation",
          "latex": "0.3\\times120+0.7\\times100=106"
        }
      ]
    },
    {
      "id": "parameter",
      "parent_id": "root",
      "label": "alpha 越大，当前观测权重越大",
      "role": "concept",
      "support": "fact",
      "source_refs": [
